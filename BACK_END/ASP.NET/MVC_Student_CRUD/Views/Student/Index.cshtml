@{
     
}

@model List<Student>

<table class="table table-striped table-dark">
    <thead>
        <tr>
           
            <th scope="col">Student ID</th>
            <th scope="col">Student Name</th>
            <th scope="col">Student Age</th>
        </tr>
    </thead>
    <tbody>
       
    </tbody>


    @foreach (var s in Model)
    {
        <tr>
            <td>@s.StudentId</td>
            <td>@s.StudentName</td>
            <td>@s.StudentAge</td>
            
        </tr>
      
    }
</table>

