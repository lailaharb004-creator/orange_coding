@model IEnumerable<Product>
@{
    Layout = "_CustomerLayout";
}

<div class="container mt-5">
    <h2 class="fw-bold mb-4">Explore @ViewBag.CategoryName</h2>

    <div class="row">
        @foreach (var product in Model)
        {
            <div class="col-md-4 col-lg-3 mb-4">
                <div class="card h-100 border-0 shadow-sm transition-card" style="border-radius: 15px; overflow: hidden;">
                    <div style="height: 200px; background-color: #f8f8f8; display: flex; align-items: center; justify-content: center; padding: 10px;">
                        <img src="@product.ImageUrl" style="max-height: 100%; max-width: 100%; object-fit: contain;">
                    </div>
                    <div class="card-body d-flex flex-column justify-content-between">
                        <div>
                            <h6 class="fw-bold">@product.ProductTitle</h6>
                            <p class="text-primary fw-bold">@product.ProductPrice.ToString("C")</p>
                        </div>
                        <a href="#" class="btn btn-dark btn-sm rounded-pill shadow-sm py-2">Add to Cart</a>
                    </div>
                </div>
            </div>
        }
    </div>
</div>

<style>
    .transition-card:hover {
        transform: translateY(-5px);
        transition: 0.3s ease;
        box-shadow: 0 10px 20px rgba(0,0,0,0.1) !important;
    }
</style>
