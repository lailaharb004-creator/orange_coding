@model Product
@{
    Layout = "_AdminLayout";
}

<div class="container mt-5">
    <div class="card shadow border-0" style="border-radius: 20px;">
        <div class="card-header bg-danger bg-gradient text-light py-3">
            <h4 class="mb-0">Delete Product</h4>
        </div>
        <div class="card-body p-4">
            <h3 class="text-center mb-4">Are you sure you want to delete this product?</h3>
            <div class="row">
                <div class="col-md-4 text-center">
                    <img src="@Model.ImageUrl" style="max-height: 200px; object-fit: contain;" class="img-fluid rounded" />
                </div>
                <div class="col-md-8">
                    <h5 class="fw-bold">@Model.ProductTitle</h5>
                    <p class="text-muted">Category: @Model.Category?.CategoryName</p>
                    <p class="h4 text-primary">@Model.ProductPrice.ToString("C")</p>
                </div>
            </div>

            <form method="post" asp-action="Delete" class="mt-4 text-center">
                <input type="hidden" asp-for="ProductId" />
                <button type="submit" class="btn btn-danger px-5 rounded-pill shadow">Confirm Delete</button>
                <a asp-action="Index" class="btn btn-secondary px-5 rounded-pill shadow">Cancel</a>
            </form>
        </div>
    </div>
</div>
