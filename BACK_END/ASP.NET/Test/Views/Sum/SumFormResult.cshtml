<form method="post">
    <div class="row">

        <div class="col">
            <input type="text" class="form-control" placeholder="First Number" name="n1" value="@Context.Session.GetInt32("n1")">
        </div>
        <div class="col">
            <input type="text" class="form-control" placeholder="Second Number" name="n2" value="@Context.Session.GetInt32("n2")">
        </div>


        <div class="col">
            <input type="text" class="form-control" placeholder="Result " value="@Context.Session.GetInt32("Sum")">

        </div>

    </div>
</form>